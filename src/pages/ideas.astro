---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const ideas = (await getCollection('ideas')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const label = { idea: 'Just an idea', exploring: 'Exploring' };
---
<Base title="Future builds · Josh Paper">
  <h1>Future builds</h1>
  <p>
    Ideas I'm floating around. Nothing here is confirmed: some may become real
    builds, some will quietly disappear. When one gets going it moves to
    <a href="/builds/">Builds</a>.
  </p>
  {ideas.length === 0 && <p class="meta">Nothing on the list right now.</p>}
  {ideas.map((i) => (
    <div class="card">
      <h3>{i.data.title}</h3>
      <div class="meta">{label[i.data.stage]}</div>
      <p>{i.data.summary}</p>
      {i.data.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  ))}
</Base>
