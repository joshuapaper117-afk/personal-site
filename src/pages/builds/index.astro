---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import BuildTile from '../../components/BuildTile.astro';
import { getBuilds, pad } from '../../lib/builds';

const builds = await getBuilds();
---
<Base title="Builds · Josh Paper">
  <PageHead kicker={['Index', `${pad(builds.length, 2)} builds`, 'Newest first']} title="Builds" />
  <p class="lede">Everything I've built and written up, with what worked, what didn't, and what I'd change.</p>
  <div class="tiles">
    {builds.map((b) => <BuildTile build={b} />)}
  </div>
</Base>
