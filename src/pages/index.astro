---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const builds = (await getCollection('builds', (b) => !b.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base title="Josh Paper">
  <section id="about">
    <h1>Hi, I'm Josh.</h1>
    <p>
      I'm a project manager at the largest software company in the UK, which
      means I spend a lot of time around people building things. Eventually I
      got tired of just watching and started building my own.
    </p>
    <p>
      I enjoy tinkering, poking at software to see how it works and see if I can
      rebuild it a bit better. Right now that's games in Godot, web and app
      development, and plenty of messing around with AI.
    </p>
    <p>
      This site is where I keep track of it all: each build gets its own write-up,
      including what worked, what didn't, and what I'd do differently. If you
      want the formal version, my <a href="/cv/">CV</a> is here too.
    </p>
  </section>

  <section>
    <h2>Latest builds</h2>
    {builds.map((b) => (
      <div class="card">
        <h3><a href={`/builds/${b.id}/`}>{b.data.title}</a></h3>
        <div class="meta">{b.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })} · {b.data.status}</div>
        <p>{b.data.summary}</p>
      </div>
    ))}
    <p><a href="/builds/">All builds →</a> · <a href="/ideas/">Ideas I'm floating →</a></p>
  </section>
</Base>
