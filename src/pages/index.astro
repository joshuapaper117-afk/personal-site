---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import headshot from '../assets/headshot.jpg';
import BuildTile from '../components/BuildTile.astro';
import { getBuilds, pad } from '../lib/builds';
import { getCollection } from 'astro:content';

const builds = await getBuilds();
const ideas = await getCollection('ideas');
const latest = builds.slice(0, 4);
---
<Base title="Josh Paper">
  <section class="hero" id="about-top">
    <div class="kicker"><span>Personal site</span><span>London, UK</span><span>Builds N°001–{pad(builds.length)}</span></div>
    <div class="hero-grid">
      <div class="title-wrap">
        <h1>Josh<br />Paper</h1>
        <div class="orange-block" aria-hidden="true"></div>
      </div>
      <figure class="portrait">
        <div class="portrait-img">
          <Image
            src={headshot}
            alt="Headshot of Josh"
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 40vw, 100vw"
            format="webp"
            quality={82}
            loading="eager"
          />
        </div>
        <figcaption><span class="label">Portrait</span><span>Josh Paper — Project manager</span></figcaption>
      </figure>
    </div>
    <div class="hero-meta">
      <p><small>Now</small>Project manager. Tinkerer. Building things and writing them up.</p>
    </div>
  </section>

  <section class="about" id="about">
    <span class="label">01 About</span>
    <div class="copy">
      <p>
        I'm a project manager at one of the largest software companies in the UK, which
        means I spend a lot of time around people building things. Eventually I
        got tired of just watching and started building my own.
      </p>
      <p>
        I enjoy tinkering, poking at software to see how it works and see if I can
        rebuild it a bit better. Right now that's games in Godot, web and app
        development, and plenty of messing around with AI.
      </p>
      <p>
        This site is where I keep track of it all: each build gets its own write-up,
        including what worked, what didn't, and what I'd do differently. If you
        want the formal version, my <a href="/cv/">CV</a> is here too.
      </p>
    </div>
  </section>

  <section>
    <div class="sec-head"><h2>Builds</h2><span class="mono">[{pad(builds.length, 2)}]</span></div>
    <div class="tiles">
      {latest.map((b) => <BuildTile build={b} />)}
      <a class="tile ghost" href="/ideas/">
        <div class="tile-top"><span class="mono">Next</span><span class="chip ghost">{ideas.length} unconfirmed</span></div>
        <div class="tile-num" aria-hidden="true">{pad(builds.length + 1, 2)}</div>
        <div class="tile-body"><h3>What's next?</h3><p>Ideas I'm floating around. Nothing here is confirmed.</p></div>
      </a>
    </div>
    <div class="more"><a href="/builds/">All builds →</a><a href="/ideas/">Future builds →</a></div>
  </section>
</Base>
