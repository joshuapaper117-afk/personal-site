---
import { pad, statusLabel, toneFor, type Build } from '../lib/builds';
interface Props { build: Build }
const { build } = Astro.props;
const d = build.data;
---
<a class={`tile ${toneFor(build.n)}`} href={`/builds/${build.id}/`}>
  <div class="tile-top">
    <span class="mono">N°{pad(build.n)}</span>
    <span class="chip" data-status={d.status}><i></i>{statusLabel[d.status]}</span>
  </div>
  <div class="tile-num" aria-hidden="true">{pad(build.n, 2)}</div>
  <div class="tile-body">
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
  </div>
</a>
